# Copy to .env and adjust if the compose database is not on the default port.
DATABASE_URL=postgres://wellis:wellis@localhost:55432/wellis

# Only for production: npm run db:migrate uses this session-pooler URL (Supabase port 5432) when
# set, the same role and secret as DATABASE_URL, which stays on the transaction pooler (6543).
# Nothing else reads it. Unset locally and in CI, where one URL serves both (ADR-0008).
# MIGRATION_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# The integration tests create and drop databases on the DATABASE_URL host and refuse a host
# other than localhost unless this is set.
# ALLOW_REMOTE_TEST_DATABASE=1

# The care team the audit log names (ADR-0014 item 4), applied by `npm run seed:reviewers`.
# The console's login lists exactly these people; picking one is identification, not
# authentication, which is a deliberate scope cut (README, ADR-0021).
REVIEWERS=[{"name":"Dr Vermeer","role":"doctor"},{"name":"Sanne Bakker","role":"ops"}]

# The review console has one shared secret: it locks the door, and the reviewer still picks
# their own name from the seeded list above (ADR-0021). At least 32 characters. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CONSOLE_SECRET=generate-your-own-at-least-32-characters
