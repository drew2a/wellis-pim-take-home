# Copy to .env and adjust if the compose database is not on the default port.
DATABASE_URL=postgres://wellis:wellis@localhost:55432/wellis

# Only for production: npm run db:migrate and the importer use this session-pooler URL (Supabase
# port 5432) when set; the app keeps DATABASE_URL on the transaction pooler (port 6543).
# Unset locally and in CI, where one URL serves both.
# MIGRATION_URL=postgresql://user:password@host:5432/postgres?sslmode=require
