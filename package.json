{
  "name": "wellis-intake",
  "version": "0.0.0",
  "private": true,
  "description": "Wellis Intake: legacy import, patient intake with eligibility rules, review console",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "profile": "tsx scripts/profile/profile.ts",
    "typecheck": "tsc --noEmit",
