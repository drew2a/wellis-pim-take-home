{
  "name": "wellis-intake",
  "version": "0.0.0",
  "private": true,
  "description": "Wellis Intake: legacy import, patient intake with eligibility rules, review console",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run schema:diagram -- --check && npm test && npm run test:integration",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "drizzle-kit migrate",
    "profile": "tsx scripts/profile/profile.ts",
    "profile:hypotheses": "tsx scripts/profile/hypotheses.ts",
    "profile:inventory": "tsx scripts/profile/inventory.ts",
    "schema:diagram": "tsx scripts/schema/diagram.ts",
    "import": "tsx src/import/cli.ts",
    "seed:reviewers": "tsx src/reviewers/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "csv-parse": "^7.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.1"
  }
}
